{
  "name": "flo-desktop",
  "version": "1.6.5",
  "description": "POS Koperasi - Sistem Kasir dan Manajemen Koperasi",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build:frontend && npm run build && electron .",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "tsc",
    "build:frontend": "cd frontend && npm ci && npx cross-env NEXT_BUILD_MODE=desktop npm run build",
    "build:all-platforms": "npm run build:frontend && npm run build && electron-builder --win --mac --linux",
    "build:win": "npm run build:frontend && npm run build && electron-builder --win",
    "build:mac": "npm run build:frontend && npm run build && electron-builder --mac",
    "build:linux": "npm run build:frontend && npm run build && electron-builder --linux",
    "test:smoke": "npm run build && electron --no-sandbox scripts/smoke-test.cjs",
    "pack": "electron-builder --dir",
    "start": "electron ."
  },
  "author": {
    "name": "POS Koperasi",
    "email": "support@koperasi.local"
  },
  "homepage": "https://koperasi.local",
  "license": "MIT",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/pdfmake": "^0.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.10",
    "electron": "^41.10.6",
    "electron-builder": "26.17.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "node-thermal-printer": "^4.2.1",
    "pdfmake": "^0.3.11",
    "qrcode": "^1.5.3",
    "uuid": "^11.1.1",
    "ws": "^8.17.0"
  },
  "overrides": {
    "@electron/get": "^5.1.0",
    "builder-util-runtime": "^9.7.0",
    "qs": "^6.16.0",
    "tar": "^7.5.22",
    "uuid": "$uuid"
  },
  "build": {
    "appId": "com.flo.desktop",
    "productName": "POS Koperasi",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": "**/node_modules/better-sqlite3/**/*",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "frontend/out",
        "to": "frontend-out"
      },
      {
        "from": "flo.db",
        "to": "initial-flo.db"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "POSKoperasiTehang-Setup-v${version}-20261006.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.business",
      "identity": "Codify Apps Private Limited (BKDY677XJA)",
      "entitlements": "build/entitlements.plist",
      "entitlementsInherit": "build/entitlements.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
