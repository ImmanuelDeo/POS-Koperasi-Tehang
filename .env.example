# Runtime environment
NODE_ENV=development
PORT=3001

# Required in production: minimum 32 random characters.
# Do not commit a real secret.
JWT_SECRET=

# Optional: comma-separated approved browser origins for LAN.
# Same-origin POS/Office at port 3001 works without this setting.
ALLOWED_LAN_ORIGINS=

# Privacy safeguards. Keep false for POS Koperasi.
ENABLE_AUTO_UPDATER=false
ENABLE_CLOUD_SYNC=false

# Kiosk mode: only activates when NODE_ENV=production and ENABLE_KIOSK_MODE=true.
# Set to false for local development and non-kiosk production testing.
ENABLE_KIOSK_MODE=false

